---
export interface Props {
  type: "marigold" | "toran" | "paisley" | "sunburst" | "seal" | "truck" | "phone" | "whatsapp" | "stars" | "paisleyCorner";
  size?: number;
  color?: string;
  center?: string;
  count?: number;
}
const { type, size, color, center, count } = Astro.props;
---

{type === "marigold" && (
  <svg width={size ?? 80} height={size ?? 80} viewBox="0 0 100 100" aria-hidden="true">
    <g transform="translate(50 50)">
      {Array.from({ length: 12 }).map((_, i) => (
        <ellipse cx="0" cy="-30" rx="9" ry="18" fill={color ?? "var(--marigold)"} transform={`rotate(${i * 30})`} opacity="0.9" />
      ))}
      {Array.from({ length: 12 }).map((_, i) => (
        <ellipse cx="0" cy="-22" rx="7" ry="13" fill={color ?? "var(--marigold)"} transform={`rotate(${i * 30 + 15})`} opacity="1" />
      ))}
      <circle r="11" fill={center ?? "var(--terracotta)"} />
      <circle r="6" fill={color ?? "var(--marigold)"} opacity="0.6" />
    </g>
  </svg>
)}

{type === "toran" && (
  <svg width="100%" height="42" viewBox={`0 0 ${(count ?? 8) * 40} 42`} preserveAspectRatio="none" aria-hidden="true">
    {Array.from({ length: count ?? 8 }).map((_, i) => {
      const x = i * 40 + 20;
      return (
        <g>
          <path d={`M${i * 40} 0 Q ${x} 14 ${(i + 1) * 40} 0`} stroke={"var(--terracotta)"} stroke-width="1.5" fill="none" opacity="0.5" />
          <circle cx={x} cy="20" r="6" fill={"var(--marigold)"} />
          <circle cx={x} cy="20" r="2.5" fill={"var(--terracotta)"} />
          <path d={`M${x} 26 L${x} 38`} stroke={"var(--terracotta)"} stroke-width="1" />
          <circle cx={x} cy="38" r="2" fill={"var(--terracotta)"} />
        </g>
      );
    })}
  </svg>
)}

{type === "paisley" && (
  <svg width="120" height="24" viewBox="0 0 120 24" aria-hidden="true">
    <line x1="0" y1="12" x2="42" y2="12" stroke={color ?? "var(--terracotta)"} stroke-width="1" opacity="0.4" />
    <line x1="78" y1="12" x2="120" y2="12" stroke={color ?? "var(--terracotta)"} stroke-width="1" opacity="0.4" />
    <path d="M60 4 C 68 4, 72 10, 70 14 C 68 18, 60 18, 56 14 C 52 10, 56 6, 60 4 Z" fill={color ?? "var(--terracotta)"} opacity="0.85" />
    <circle cx="48" cy="12" r="2" fill={color ?? "var(--terracotta)"} />
    <circle cx="72" cy="12" r="2" fill={color ?? "var(--terracotta)"} />
  </svg>
)}

{type === "sunburst" && (
  <svg width={size ?? 200} height={size ?? 200} viewBox="0 0 200 200" aria-hidden="true">
    <g transform="translate(100 100)">
      {Array.from({ length: 24 }).map((_, i) => (
        <rect x="-1" y="-90" width="2" height="40" fill={color ?? "var(--marigold)"} transform={`rotate(${i * 15})`} opacity="0.7" />
      ))}
      <circle r="46" fill="none" stroke={color ?? "var(--marigold)"} stroke-width="1" opacity="0.4" />
      <circle r="34" fill="none" stroke={color ?? "var(--marigold)"} stroke-width="1" opacity="0.5" />
    </g>
  </svg>
)}

{type === "seal" && (
  <div style="position: relative; width: 110px; height: 110px; display: grid; place-items: center; color: var(--terracotta); font-family: var(--serif); font-weight: 900;">
    <svg width="110" height="110" viewBox="0 0 110 110" style="position: absolute; inset: 0;">
      <circle cx="55" cy="55" r="52" fill="none" stroke="var(--terracotta)" stroke-width="2" />
      <circle cx="55" cy="55" r="46" fill="none" stroke="var(--terracotta)" stroke-width="1" />
      <circle cx="55" cy="55" r="44" fill="none" stroke="var(--terracotta)" stroke-width="1" stroke-dasharray="2 3" />
      <defs>
        <path id="seal-circle" d="M 55 55 m -38 0 a 38 38 0 1 1 76 0 a 38 38 0 1 1 -76 0" />
      </defs>
      <text fill="var(--terracotta)" font-size="9" font-family="var(--sans)" font-weight="700" letter-spacing="2">
        <textPath href="#seal-circle" startOffset="0%">★ TRUSTED SINCE 1999 · HAMIRPUR · HP ★ </textPath>
      </text>
    </svg>
    <div style="text-align: center; line-height: 0.95; z-index: 1;">
      <div style="font-size: 22px; line-height: 0.9;">25</div>
      <div style="font-size: 9px; letter-spacing: 1px; margin-top: 2px;">YEARS</div>
    </div>
  </div>
)}

{type === "truck" && (
  <svg width={size ?? 22} height={size ?? 22} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M2 7h11v9H2zM13 11h5l3 3v2h-8z" /><circle cx="6" cy="18" r="2" /><circle cx="17" cy="18" r="2" />
  </svg>
)}

{type === "phone" && (
  <svg width={size ?? 22} height={size ?? 22} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z" />
  </svg>
)}

{type === "whatsapp" && (
  <svg width={size ?? 22} height={size ?? 22} viewBox="0 0 24 24" fill="currentColor">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374A9.86 9.86 0 012.166 11.9c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884" />
  </svg>
)}

{type === "stars" && (
  <div style="display: inline-flex; gap: 2px;">
    {Array.from({ length: count ?? 5 }).map(() => (
      <svg width="14" height="14" viewBox="0 0 20 20" fill="var(--marigold)">
        <path d="M10 1l2.6 5.9 6.4.6-4.8 4.4 1.4 6.3L10 15l-5.6 3.2 1.4-6.3L1 7.5l6.4-.6z" />
      </svg>
    ))}
  </div>
)}

{type === "paisleyCorner" && (
  <svg width={size ?? 60} height={size ?? 60} viewBox="0 0 60 60" aria-hidden="true">
    <path d="M0 0 Q 30 0, 30 30 Q 30 60, 60 60" stroke={color ?? "var(--marigold)"} stroke-width="1" fill="none" opacity="0.5" />
    <path d="M0 0 Q 20 0, 20 20 Q 20 40, 40 40" stroke={color ?? "var(--marigold)"} stroke-width="1" fill="none" opacity="0.5" />
    <circle cx="30" cy="30" r="2" fill={color ?? "var(--marigold)"} />
  </svg>
)}
