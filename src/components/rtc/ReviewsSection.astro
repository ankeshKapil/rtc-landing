---
import Motif from "./Motifs.astro";

const reviews = [
  { name: "Raj Kumar", role: "Local Contractor · Hamirpur", body: "Five years of building work and never had a cement quality issue. The TMT bar rates beat the bigger shops, especially in bulk. They open early and load the truck themselves.", rating: 5 },
  { name: "Sunita Devi", role: "Dairy Farmer · Bhota", body: "Switched cattle feed to their compounded mix two years back. Milk yield up clearly. The team explains the supplements properly — not just selling.", rating: 5 },
  { name: "Mahesh Singh", role: "Restaurant Owner · Sujanpur", body: "We sourced the entire dham for our daughter's wedding from here. 350 guests, zero issue. Boti was happy. Father-in-law was happier.", rating: 5 },
  { name: "Ramesh Sharma", role: "Shopkeeper · Nadaun", body: "I run a small karyana shop and refill from Roop every fortnight. Honest weight, honest rate, honest billing. That's all you need.", rating: 5 },
];
---

<section style="background: var(--cream); position: relative; overflow: hidden;">
  <div style="position: absolute; top: 30px; right: 40px; opacity: 0.4;">
    <Motif type="marigold" size={120} />
  </div>
  <div style="position: absolute; bottom: 30px; left: 40px; opacity: 0.4; transform: scale(0.8);">
    <Motif type="marigold" size={100} />
  </div>
  <div class="container" style="position: relative;">
    <div style="text-align: center; margin-bottom: 56px;">
      <div class="eyebrow" style="justify-content: center; display: inline-flex;">From our regulars</div>
      <h2 class="section-title" style="margin-top: 12px;">Word travels fast in the valley.</h2>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--gap);">
      {reviews.map((r) => (
        <div style="background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; box-shadow: var(--card-shadow); display: flex; flex-direction: column; position: relative;">
          <div style='position: absolute; top: 16px; right: 20px; font-family: var(--serif); font-size: 64px; color: var(--marigold); line-height: 1; opacity: 0.5;'>"</div>
          <Motif type="stars" count={r.rating} />
          <p style="font-size: 15px; line-height: 1.6; color: var(--ink); margin: 16px 0 24px; flex: 1;">{r.body}</p>
          <div style="display: flex; align-items: center; gap: 12px; padding-top: 16px; border-top: 1px solid var(--line);">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--terracotta); color: #fff; display: grid; place-items: center; font-family: var(--serif); font-weight: 800; font-size: 16px;">{r.name[0]}</div>
            <div>
              <div style="font-weight: 700; font-size: 14px;">{r.name}</div>
              <div style="font-size: 12px; color: var(--ink-soft);">{r.role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
