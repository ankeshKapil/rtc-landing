    <a href="/" class="brandmark">
      <div class="seal">रू</div>
      <div>
        <div class="name">Roop Trading Company</div>
        <div class="sub">Hamirpur · Since 1999</div>
      </div>
    </a>
    <nav class="primary">
      <a href="#products">Products</a>
