---
import T from "./T.astro";
---

<header class="site">
  <div class="container-wide row">
    <a href="/" class="brandmark">
      <div class="seal">रू</div>
      <div>
        <div class="name">
          <T en="Roop Trading Company" hi="रूप ट्रेडिंग कंपनी" />
        </div>
        <div class="sub">
          <T en="Hamirpur · Since 1999" hi="हमीरपुर · 1999 से" />
        </div>
      </div>
    </a>
    <nav class="primary">
      <a href="#products"><T en="Products" hi="प्रोडक्ट्स" /></a>
      <a href="#order-builder"><T en="Order" hi="ऑर्डर" /></a>
      <a href="#dham"><T en="Dham Booking" hi="धाम बुकिंग" /></a>
      <a href="#brands"><T en="Brands" hi="ब्रांड्स" /></a>
      <a href="#delivery"><T en="Delivery" hi="डिलीवरी" /></a>
      <a href="#location"><T en="Contact" hi="संपर्क" /></a>
    </nav>
    <div class="header-cta" style="display: flex; align-items: center; gap: 12px;">
      <div class="lang-toggle" id="lang-toggle">
        <button data-lang="en" class="on" type="button">EN</button>
        <button data-lang="hi" type="button">हिं</button>
      </div>
      <a href="#bulk" class="btn btn-primary">
        <T en="Get a Quote" hi="रेट पूछें" />
      </a>
    </div>
    <button class="mobile-toggle" id="mobile-toggle" aria-label="Menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
    </button>
  </div>
</header>
