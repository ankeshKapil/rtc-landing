---
import T from "./T.astro";
import acc from "../../assets/acc.png";
import bangur from "../../assets/bangur.png";
import kamdhenu from "../../assets/Kamdhenu.svg";
import elephant from "../../assets/elephant.png";
import pmark from "../../assets/p_mark.png";
import rajdhani from "../../assets/rajdhani.png";
import rajdhaniBesan from "../../assets/rajdhani_besan.png";
import jalani from "../../assets/jalani.png";

const brands = [
  { nameEn: "ACC Cement", nameHi: "ACC सीमेंट", logo: acc.src, descEn: "Premium grade cement", descHi: "प्रीमियम ग्रेड सीमेंट" },
  { nameEn: "Bangur Cement", nameHi: "बांगुर सीमेंट", logo: bangur.src, descEn: "Construction grade", descHi: "कंस्ट्रक्शन ग्रेड" },
  { nameEn: "Kamdhenu TMT", nameHi: "कामधेनु टीएमटी", logo: kamdhenu.src, descEn: "Reinforcement bars", descHi: "सरिया" },
  { nameEn: "Elephant Masalas", nameHi: "एलिफेंट मसाले", logo: elephant.src, descEn: "Authentic spices", descHi: "असली मसाले" },
  { nameEn: "P-Mark Mustard Oil", nameHi: "P-Mark सरसों तेल", logo: pmark.src, descEn: "Cold pressed oil", descHi: "कोल्ड प्रेस्ड तेल" },
  { nameEn: "Rajdhani Oil", nameHi: "राजधानी तेल", logo: rajdhani.src, descEn: "Pure mustard oil", descHi: "शुद्ध सरसों तेल" },
  { nameEn: "Rajdhani Besan", nameHi: "राजधानी बेसन", logo: rajdhaniBesan.src, descEn: "Natural besan", descHi: "प्राकृतिक बेसन" },
  { nameEn: "Jalani Foods", nameHi: "जलानी फ़ूड्स", logo: jalani.src, descEn: "Hygienic food", descHi: "स्वच्छ खाद्य उत्पाद" },
];
---

<section id="brands" style="background: var(--paper);">
  <div class="container">
    <div style="text-align: center; margin-bottom: 56px;">
      <div class="eyebrow" style="justify-content: center; display: inline-flex;">
        <T en="Authorized partners" hi="अधिकृत पार्टनर" />
      </div>
      <h2 class="section-title" style="margin-top: 12px;">
        <T en="Direct from company. Original sealed." hi="सीधे कंपनी से। ओरिजिनल सील्ड।" />
      </h2>
      <p class="section-sub" style="margin: 16px auto 0;">
        <T en="We are authorized stockists for premium brands across categories — no duplicates, no compromise." hi="हम प्रीमियम ब्रांड्स के अधिकृत स्टॉकिस्ट हैं — कोई डुप्लीकेट नहीं, कोई समझौता नहीं।" />
      </p>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--bg);">
      {brands.map((b) => (
        <div class="brand-cell" style="padding: 32px 24px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--paper); display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px;">
          <div style="width: 90px; height: 90px; display: grid; place-items: center;">
            <img src={b.logo} alt={b.nameEn} style="max-width: 100%; max-height: 100%; object-fit: contain;" />
          </div>
          <div>
            <div style="font-family: var(--serif); font-weight: 700; font-size: 16px;">
              <T en={b.nameEn} hi={b.nameHi} />
            </div>
            <div style="font-size: 12px; color: var(--ink-soft); margin-top: 4px;">
              <T en={b.descEn} hi={b.descHi} />
            </div>
          </div>
          <div style="font-size: 10px; letter-spacing: 0.18em; color: var(--terracotta); font-weight: 700;">
            <T en="★ AUTHORIZED" hi="★ अधिकृत" />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
