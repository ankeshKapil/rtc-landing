---
import Motif from "./Motifs.astro";

const areas: [string, string][] = [
  ["Hamirpur Town", "0–5 km · same day"],
  ["Bhota, Sujanpur, Toni Devi", "5–25 km · same day"],
  ["Nadaun, Barsar, Bijhri", "25–45 km · next day"],
  ["Awah Devi, Lambloo, Galore", "By route · 1–2 days"],
  ["Bilaspur, Una border villages", "On request"],
  ["Project sites (full district)", "Free quote"],
];
---

<section id="delivery" style="background: var(--bg);">
  <div class="container">
    <div class="delivery-grid" style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 64px; align-items: start;">
      <div>
        <div class="eyebrow">Delivery zone</div>
        <h2 class="section-title" style="margin-top: 12px; max-width: 14ch;">We deliver to your village.</h2>
        <p class="section-sub" style="margin-top: 16px;">
          Paid door delivery across Hamirpur district. Same-day for nearby villages, next-day for the rest. Bulk site delivery for construction projects, anywhere in HP.
        </p>
        <div style="margin-top: 28px; padding: 20px; border-left: 3px solid var(--marigold); background: var(--paper); border-radius: 0 8px 8px 0;">
          <div style="display: flex; align-items: center; gap: 10px; color: var(--terracotta); font-weight: 700; font-size: 14px; margin-bottom: 4px;">
            <Motif type="truck" size={18} /> Free site visit for bulk orders
          </div>
          <div style="font-size: 13.5px; color: var(--ink-soft);">For construction projects above 50 bags or wholesale stock orders, we visit your site for a no-obligation quote.</div>
        </div>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden;">
        {areas.map((a, i) => (
          <div style="padding: 22px; background: var(--paper);">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
              <span style="width: 24px; height: 24px; border-radius: 50%; background: var(--cream); color: var(--terracotta); display: grid; place-items: center; font-size: 11px; font-weight: 800;">{i + 1}</span>
              <div style="font-family: var(--serif); font-weight: 700; font-size: 16px;">{a[0]}</div>
            </div>
            <div style="font-size: 13px; color: var(--forest); font-weight: 600;">{a[1]}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
