---
import Motif from "./Motifs.astro";
import T from "./T.astro";

const types = [
  { en: "Construction site", hi: "निर्माण साइट" },
  { en: "Dairy farm", hi: "डेयरी फ़ार्म" },
  { en: "Shop / resale", hi: "दुकान / पुनर्विक्रय" },
  { en: "Restaurant / dham", hi: "रेस्तराँ / धाम" },
  { en: "Household", hi: "घरेलू" },
  { en: "Other", hi: "अन्य" },
];
const whens = [
  { en: "Today", hi: "आज" },
  { en: "Tomorrow", hi: "कल" },
  { en: "This week", hi: "इस हफ़्ते" },
  { en: "Within 15 days", hi: "15 दिन के अंदर" },
  { en: "Just exploring", hi: "अभी देख रहे हैं" },
];
---

<section id="bulk" style="background: var(--bg); position: relative;">
  <div class="container">
    <div class="bulk-grid" style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 64px; align-items: start;">
      <div>
        <div class="eyebrow">
          <T en="Bulk & contractor orders" hi="थोक व ठेकेदार ऑर्डर" />
        </div>
        <h2 class="section-title" style="margin-top: 12px; max-width: 14ch;">
          <T en="Send a list. Get a price by evening." hi="लिस्ट भेजिए। शाम तक रेट।" />
        </h2>
        <p class="section-sub" style="margin-top: 16px;">
          <T en="Whether it is 50 bags of cement, a season's khal-binola or a full karyana stock for your shop — share what you need and our team will WhatsApp you a quote within hours." hi="50 बोरी सीमेंट हो, या एक सीज़न का खल-बिनौला, या आपकी दुकान का पूरा किराना स्टॉक — आप ज़रूरत भेजिए, हम कुछ ही घंटों में WhatsApp पर रेट दे देते हैं।" />
        </p>
        <div style="margin-top: 32px; padding: 20px 24px; background: var(--paper); border: 1px solid var(--line); border-radius: 12px;">
          <div style="font-family: var(--serif); font-size: 18px; font-weight: 700; margin-bottom: 6px;">
            <T en="Or just WhatsApp us" hi="या सीधे WhatsApp करें" />
          </div>
          <a href="https://wa.me/917018657685" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; gap: 10px; font-family: var(--serif); font-size: 22px; color: var(--terracotta); text-decoration: none; font-weight: 800;">
            <Motif type="whatsapp" size={22} />
            <T en="Open WhatsApp" hi="WhatsApp खोलें" />
          </a>
          <div style="font-size: 13px; color: var(--ink-soft); margin-top: 6px;">
            <T en="We reply daily, 9 AM – 7 PM" hi="हम रोज़ सुबह 9 से शाम 7 बजे जवाब देते हैं" />
          </div>
        </div>
      </div>

      <form id="bulk-form" style="background: var(--paper); border: 1px solid var(--line); border-radius: 16px; padding: 32px; box-shadow: var(--card-shadow);">
        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: var(--ink-soft); margin-bottom: 6px;">
              <T en="Your name" hi="आपका नाम" />
            </label>
            <div class="field-input">
              <input name="name" required data-ph-en="Aarav Sharma" data-ph-hi="आरव शर्मा" placeholder="Aarav Sharma" />
            </div>
          </div>
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: var(--ink-soft); margin-bottom: 6px;">
              <T en="Phone / WhatsApp" hi="फ़ोन / WhatsApp नंबर" />
            </label>
            <div class="field-input">
              <input name="phone" type="tel" required placeholder="+91 …" />
            </div>
          </div>
        </div>

        <div style="margin-bottom: 16px;">
          <label style="display: block; font-size: 13px; font-weight: 600; color: var(--ink-soft); margin-bottom: 6px;">
            <T en="I am buying for" hi="किसके लिए ख़रीद रहे हैं" />
          </label>
          <div data-chipgroup="type" style="display: flex; flex-wrap: wrap; gap: 8px;">
            {types.map((opt, i) => (
              <button type="button" class={`chip${i === 0 ? " on" : ""}`} data-value-en={opt.en} data-value-hi={opt.hi}>
                <T en={opt.en} hi={opt.hi} />
              </button>
            ))}
          </div>
          <input type="hidden" name="type" value={types[0].en} />
        </div>

        <div style="margin-bottom: 16px;">
          <label style="display: block; font-size: 13px; font-weight: 600; color: var(--ink-soft); margin-bottom: 6px;">
            <T en="What do you need?" hi="क्या-क्या चाहिए?" />
          </label>
          <div class="field-input">
            <textarea name="items" rows="4" required
              data-ph-en="e.g. 30 bags ACC cement, 200kg cattle feed, masala stock for shop…"
              data-ph-hi="जैसे: 30 बोरी ACC सीमेंट, 200 किलो पशु आहार, दुकान का मसाला स्टॉक…"
              placeholder="e.g. 30 bags ACC cement, 200kg cattle feed, masala stock for shop…"></textarea>
          </div>
        </div>

        <div style="margin-bottom: 16px;">
          <label style="display: block; font-size: 13px; font-weight: 600; color: var(--ink-soft); margin-bottom: 6px;">
            <T en="When do you need it?" hi="कब चाहिए?" />
          </label>
          <div data-chipgroup="when" data-style="forest" style="display: flex; flex-wrap: wrap; gap: 8px;">
            {whens.map((opt, i) => (
              <button type="button" class={`chip${i === 0 ? " on-forest" : ""}`} data-value-en={opt.en} data-value-hi={opt.hi}>
                <T en={opt.en} hi={opt.hi} />
              </button>
            ))}
          </div>
          <input type="hidden" name="when" value={whens[0].en} />
        </div>

        <button type="submit" class="btn btn-wa" style="width: 100%; padding: 16px; font-size: 16px; margin-top: 8px; justify-content: center;">
          <Motif type="whatsapp" size={18} />
          <T en="Send to WhatsApp" hi="WhatsApp पर भेजें" />
        </button>
        <div style="font-size: 12px; color: var(--ink-soft); text-align: center; margin-top: 10px;">
          <T en="We'll only use this to share your quote." hi="हम इसका इस्तेमाल सिर्फ़ रेट भेजने के लिए करेंगे।" />
        </div>
      </form>
    </div>
  </div>
</section>
