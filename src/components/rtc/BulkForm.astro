---
import Motif from "./Motifs.astro";

const types = ["Construction site", "Dairy farm", "Shop / resale", "Restaurant / dham", "Household", "Other"];
const whens = ["Today", "Tomorrow", "This week", "Within 15 days", "Just exploring"];
---

<section id="bulk" style="background: var(--bg); position: relative;">
  <div class="container">
    <div class="bulk-grid" style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 64px; align-items: start;">
      <div>
        <div class="eyebrow">Bulk &amp; contractor orders</div>
        <h2 class="section-title" style="margin-top: 12px; max-width: 14ch;">Send a list. Get a price by evening.</h2>
        <p class="section-sub" style="margin-top: 16px;">
          Whether it is 50 bags of cement, a season's khal-binola or a full karyana stock for your shop — share what you need and our team will WhatsApp you a quote within hours.
        </p>
        <div style="margin-top: 32px; padding: 20px 24px; background: var(--paper); border: 1px solid var(--line); border-radius: 12px;">
          <div style="font-family: var(--serif); font-size: 18px; font-weight: 700; margin-bottom: 6px;">Or just call</div>
          <a href="tel:+917018657685" style="font-family: var(--serif); font-size: 28px; color: var(--terracotta); text-decoration: none; font-weight: 800;">+91 7018 657 685</a>
          <div style="font-size: 13px; color: var(--ink-soft); margin-top: 6px;">Daily 9 AM – 7 PM</div>
        </div>
      </div>

      <form id="bulk-form" style="background: var(--paper); border: 1px solid var(--line); border-radius: 16px; padding: 32px; box-shadow: var(--card-shadow);">
        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: var(--ink-soft); margin-bottom: 6px;">Your name</label>
            <div class="field-input"><input name="name" required placeholder="Aarav Sharma" /></div>
          </div>
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: var(--ink-soft); margin-bottom: 6px;">Phone / WhatsApp</label>
            <div class="field-input"><input name="phone" type="tel" required placeholder="+91 …" /></div>
          </div>
        </div>

        <div style="margin-bottom: 16px;">
          <label style="display: block; font-size: 13px; font-weight: 600; color: var(--ink-soft); margin-bottom: 6px;">I am buying for</label>
          <div data-chipgroup="type" style="display: flex; flex-wrap: wrap; gap: 8px;">
            {types.map((opt, i) => (
              <button type="button" class={`chip${i === 0 ? " on" : ""}`} data-value={opt}>{opt}</button>
            ))}
          </div>
          <input type="hidden" name="type" value={types[0]} />
        </div>

        <div style="margin-bottom: 16px;">
          <label style="display: block; font-size: 13px; font-weight: 600; color: var(--ink-soft); margin-bottom: 6px;">What do you need?</label>
          <div class="field-input"><textarea name="items" rows="4" required placeholder="e.g. 30 bags ACC cement, 200kg cattle feed, masala stock for shop…"></textarea></div>
        </div>

        <div style="margin-bottom: 16px;">
          <label style="display: block; font-size: 13px; font-weight: 600; color: var(--ink-soft); margin-bottom: 6px;">When do you need it?</label>
          <div data-chipgroup="when" data-style="forest" style="display: flex; flex-wrap: wrap; gap: 8px;">
            {whens.map((opt, i) => (
              <button type="button" class={`chip${i === 0 ? " on-forest" : ""}`} data-value={opt}>{opt}</button>
            ))}
          </div>
          <input type="hidden" name="when" value={whens[0]} />
        </div>

        <button type="submit" class="btn btn-wa" style="width: 100%; padding: 16px; font-size: 16px; margin-top: 8px; justify-content: center;">
          <Motif type="whatsapp" size={18} /> Send to WhatsApp
        </button>
        <div style="font-size: 12px; color: var(--ink-soft); text-align: center; margin-top: 10px;">We'll only use this to share your quote.</div>
      </form>
    </div>
  </div>
</section>
