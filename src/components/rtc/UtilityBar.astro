---
import Motif from "./Motifs.astro";
import T from "./T.astro";
---

<div class="util-bar">
  <div class="container-wide">
    <div class="util-pills">
      <span style="display: inline-flex; align-items: center; gap: 6px;">
        <span style="width: 6px; height: 6px; border-radius: 50%; background: #7BD389;"></span>
        <T en="Open 9:00 AM – 7:00 PM · All Days" hi="रोज़ खुला · सुबह 9 से शाम 7 बजे तक" />
      </span>
      <span class="util-extra">·</span>
      <span class="util-extra" style="display: inline-flex; align-items: center; gap: 6px;">
        <Motif type="truck" size={14} />
        <T en="Paid delivery across Hamirpur district" hi="हमीरपुर ज़िले में डिलीवरी उपलब्ध" />
      </span>
    </div>
    <div class="util-pills">
      <span class="util-extra"><T en="GST Registered" hi="GST रजिस्टर्ड" /></span>
      <span class="util-extra">·</span>
      <a href="https://wa.me/917018657685" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; gap: 6px;">
        <Motif type="whatsapp" size={13} />
        <T en="WhatsApp us" hi="WhatsApp करें" />
      </a>
    </div>
  </div>
</div>
