---
import Layout from "../layouts/Layout.astro";
import "../styles/rtc.css";
import UtilityBar from "../components/rtc/UtilityBar.astro";
import SiteHeader from "../components/rtc/SiteHeader.astro";
import Hero from "../components/rtc/Hero.astro";
import TrustStrip from "../components/rtc/TrustStrip.astro";
import Categories from "../components/rtc/Categories.astro";
import DhamSection from "../components/rtc/DhamSection.astro";
import BulkForm from "../components/rtc/BulkForm.astro";
import BrandsSection from "../components/rtc/BrandsSection.astro";
import DeliverySection from "../components/rtc/DeliverySection.astro";
import ReviewsSection from "../components/rtc/ReviewsSection.astro";
import LocationSection from "../components/rtc/LocationSection.astro";
import SiteFooter from "../components/rtc/SiteFooter.astro";
import FloatActions from "../components/rtc/FloatActions.astro";
---

<Layout
  title="Roop Trading Company — Hamirpur, HP"
  description="Karyana, cattle feed, cement, TMT and Himachali dham catering — under one roof in Hamirpur since 1999. Authorized dealer of ACC, Bangur, Kamdhenu, Elephant Masalas and more."
  bare={true}
  bodyClass="rtc-page"
  fontHref="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700;9..144,900&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Tiro+Devanagari+Hindi:ital@0;1&family=Hind:wght@400;500;600;700&display=swap"
>
  <UtilityBar />
  <SiteHeader />
  <main>
    <Hero />
    <TrustStrip />
    <Categories />
    <DhamSection />
    <BulkForm />
    <BrandsSection />
    <DeliverySection />
    <ReviewsSection />
    <LocationSection />
  </main>
  <SiteFooter />
  <FloatActions />
</Layout>

<script>
  type Lang = "en" | "hi";

  function applyLang(lang: Lang) {
    document.body.dataset.lang = lang;

    document.querySelectorAll<HTMLElement>("#lang-toggle button").forEach((b) => {
      b.classList.toggle("on", b.dataset.lang === lang);
    });

    document.querySelectorAll<HTMLElement>("[data-chipgroup]").forEach((group) => {
      const hidden = group.parentElement?.querySelector<HTMLInputElement>("input[type=hidden]");
      const active = group.querySelector<HTMLButtonElement>("button.chip.on, button.chip.on-forest");
      if (hidden && active) {
        hidden.value = (lang === "hi" ? active.dataset.valueHi : active.dataset.valueEn) || "";
      }
    });

    document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
      "#bulk-form input[data-ph-en], #bulk-form textarea[data-ph-en]"
    ).forEach((el) => {
      const ph = lang === "hi" ? el.dataset.phHi : el.dataset.phEn;
      if (ph) el.placeholder = ph;
    });
  }

  document.getElementById("lang-toggle")?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.tagName !== "BUTTON") return;
    const lang = target.dataset.lang as Lang | undefined;
    if (lang === "en" || lang === "hi") applyLang(lang);
  });

  document.querySelectorAll<HTMLElement>("[data-chipgroup]").forEach((group) => {
    const hidden = group.parentElement?.querySelector<HTMLInputElement>("input[type=hidden]");
    const onClass = group.dataset.style === "forest" ? "on-forest" : "on";
    group.querySelectorAll<HTMLButtonElement>("button.chip").forEach((btn) => {
      btn.addEventListener("click", () => {
        group.querySelectorAll("button.chip").forEach((b) => {
          b.classList.remove("on", "on-forest");
        });
        btn.classList.add(onClass);
        if (hidden) {
          const lang = (document.body.dataset.lang || "en") as Lang;
          hidden.value = (lang === "hi" ? btn.dataset.valueHi : btn.dataset.valueEn) || "";
        }
      });
    });
  });

  const bulkForm = document.getElementById("bulk-form") as HTMLFormElement | null;
  bulkForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    const f = new FormData(bulkForm);
    const msg = encodeURIComponent(
      `Bulk Quote Request — ${f.get("name")}\nPhone: ${f.get("phone")}\nFor: ${f.get("type")}\nWhen: ${f.get("when")}\n\nItems:\n${f.get("items")}`
    );
    window.open(`https://wa.me/917018657685?text=${msg}`, "_blank");
  });
</script>
